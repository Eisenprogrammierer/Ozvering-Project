{
  "schema": 2,
  "id": "organ.exchange",
  "kind": "organ",
  "name": "Обменный орган",
  "description": "Торговля/финансы: запас, прибыль, давление, эмбарго, восстановление.",
  "initial": "forming",
  "states": {
    "forming": {
      "label": "Формирование",
      "x": 80,
      "y": 100,
      "transitions": [
        {
          "to": "stocked",
          "event": "канал открыт",
          "guard": "орган вошёл в строй",
          "priority": 10,
          "when": [
            {
              "kind": "turn",
              "op": ">=",
              "value": 1
            },
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.25
            }
          ]
        }
      ],
      "initial": true
    },
    "stocked": {
      "label": "Запас",
      "x": 300,
      "y": 100,
      "transitions": [
        {
          "to": "profitable",
          "event": "прибыль",
          "guard": "оборот пошёл",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "influence",
              "op": ">=",
              "value": 0.3
            }
          ]
        }
      ]
    },
    "profitable": {
      "label": "Прибыль",
      "x": 530,
      "y": 100,
      "transitions": [
        {
          "to": "pressured",
          "event": "давление",
          "guard": "баланс качнулся",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "influence",
              "op": "<",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "pressured": {
      "label": "Давление",
      "x": 760,
      "y": 100,
      "transitions": [
        {
          "to": "embargo",
          "event": "эмбарго",
          "guard": "страх перевесил выгоду",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "fear",
              "op": ">=",
              "value": 0.45
            }
          ]
        },
        {
          "to": "stocked",
          "event": "запас восстановлен",
          "guard": "поставки вернулись",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.5
            }
          ]
        }
      ]
    },
    "embargo": {
      "label": "Эмбарго",
      "x": 760,
      "y": 300,
      "transitions": [
        {
          "to": "recovery",
          "event": "восстановление",
          "guard": "канал снова открыт",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.4
            }
          ]
        },
        {
          "to": "disbanded",
          "event": "расформирование",
          "guard": "канал потерян",
          "priority": 30,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.15
            }
          ]
        }
      ]
    },
    "recovery": {
      "label": "Восстановление",
      "x": 530,
      "y": 300,
      "transitions": [
        {
          "to": "profitable",
          "event": "новая прибыль",
          "guard": "влияние восстановлено",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "influence",
              "op": ">=",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "disbanded": {
      "label": "Расформирование",
      "x": 300,
      "y": 300,
      "transitions": [],
      "final": true
    }
  },
  "handlers": {},
  "inputs": {
    "clauses": [
      "turn",
      "asset"
    ],
    "authority": "faction assets"
  }
}
