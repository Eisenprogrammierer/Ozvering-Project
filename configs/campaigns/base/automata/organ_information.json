{
  "schema": 2,
  "id": "organ.information",
  "kind": "organ",
  "name": "Информационный орган",
  "description": "Пропаганда/связь: молчание, нарратив, кампания, дискредитация.",
  "initial": "forming",
  "states": {
    "forming": {
      "label": "Формирование",
      "x": 80,
      "y": 100,
      "transitions": [
        {
          "to": "silent",
          "event": "орган собран",
          "guard": "канал готов",
          "priority": 10,
          "when": [
            {
              "kind": "turn",
              "op": ">=",
              "value": 1
            }
          ]
        }
      ],
      "initial": true
    },
    "silent": {
      "label": "Молчание",
      "x": 300,
      "y": 100,
      "transitions": [
        {
          "to": "narrative",
          "event": "нарратив",
          "guard": "влияние позволяет говорить",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "influence",
              "op": ">=",
              "value": 0.3
            }
          ]
        }
      ]
    },
    "narrative": {
      "label": "Нарратив",
      "x": 530,
      "y": 100,
      "transitions": [
        {
          "to": "campaign",
          "event": "кампания",
          "guard": "законность поддерживает слово",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "legitimacy",
              "op": ">=",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "campaign": {
      "label": "Кампания",
      "x": 760,
      "y": 100,
      "transitions": [
        {
          "to": "discredited",
          "event": "дискредитация",
          "guard": "слово перестало работать",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "legitimacy",
              "op": "<",
              "value": 0.35
            }
          ]
        },
        {
          "to": "silent",
          "event": "канал замолчал",
          "guard": "влияние упало",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "influence",
              "op": "<",
              "value": 0.25
            }
          ]
        }
      ]
    },
    "discredited": {
      "label": "Дискредитация",
      "x": 760,
      "y": 300,
      "transitions": [
        {
          "to": "narrative",
          "event": "новый нарратив",
          "guard": "доверие вернулось",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": ">=",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "disbanded": {
      "label": "Расформирование",
      "x": 300,
      "y": 300,
      "transitions": [],
      "final": true
    }
  },
  "handlers": {},
  "inputs": {
    "clauses": [
      "turn",
      "asset"
    ],
    "authority": "faction assets"
  }
}
