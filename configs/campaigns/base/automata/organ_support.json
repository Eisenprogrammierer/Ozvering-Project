{
  "schema": 2,
  "id": "organ.support",
  "kind": "organ",
  "name": "Орган опоры",
  "description": "Поддержка своих: готовность, перегрузка, передышка, выгорание и восстановление.",
  "initial": "forming",
  "states": {
    "forming": {
      "label": "Формирование",
      "x": 80,
      "y": 100,
      "transitions": [
        {
          "to": "ready",
          "event": "опора собрана",
          "guard": "орган вошёл в строй",
          "priority": 10,
          "when": [
            {
              "kind": "turn",
              "op": ">=",
              "value": 1
            },
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": ">=",
              "value": 0.2
            }
          ]
        }
      ],
      "initial": true
    },
    "ready": {
      "label": "Готовность",
      "x": 300,
      "y": 100,
      "transitions": [
        {
          "to": "overloaded",
          "event": "перегрузка",
          "guard": "просьб больше, чем сил",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": "<",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "overloaded": {
      "label": "Перегрузка",
      "x": 530,
      "y": 100,
      "transitions": [
        {
          "to": "relief",
          "event": "передышка",
          "guard": "часть нагрузки снята",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "energy",
              "op": "<",
              "value": 0.3
            }
          ]
        },
        {
          "to": "ready",
          "event": "силы вернулись",
          "guard": "снабжение восстановлено",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.5
            }
          ]
        }
      ]
    },
    "relief": {
      "label": "Передышка",
      "x": 760,
      "y": 100,
      "transitions": [
        {
          "to": "burnout",
          "event": "выгорание",
          "guard": "опора истощена",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.2
            }
          ]
        },
        {
          "to": "ready",
          "event": "возврат к опоре",
          "guard": "нагрузка спала",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "energy",
              "op": ">=",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "burnout": {
      "label": "Выгорание",
      "x": 760,
      "y": 300,
      "transitions": [
        {
          "to": "restored",
          "event": "восстановление",
          "guard": "опора вернулась",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": ">=",
              "value": 0.4
            }
          ]
        },
        {
          "to": "disbanded",
          "event": "расформирование",
          "guard": "орган не восстановить",
          "priority": 30,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.15
            }
          ]
        }
      ]
    },
    "restored": {
      "label": "Восстановление",
      "x": 530,
      "y": 300,
      "transitions": [
        {
          "to": "ready",
          "event": "снова в строю",
          "guard": "готовность подтверждена",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "energy",
              "op": ">=",
              "value": 0.3
            }
          ]
        }
      ]
    },
    "disbanded": {
      "label": "Расформирование",
      "x": 300,
      "y": 300,
      "transitions": [],
      "final": true
    }
  },
  "handlers": {},
  "inputs": {
    "clauses": [
      "turn",
      "asset"
    ],
    "authority": "faction assets"
  }
}
