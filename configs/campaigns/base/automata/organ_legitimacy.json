{
  "schema": 2,
  "id": "organ.legitimacy",
  "kind": "organ",
  "name": "Орган законности",
  "description": "Собор/суд: ритуал, публичная кампания, скандал, реставрация.",
  "initial": "forming",
  "states": {
    "forming": {
      "label": "Формирование",
      "x": 80,
      "y": 100,
      "transitions": [
        {
          "to": "ritual",
          "event": "ритуал",
          "guard": "орган освящён",
          "priority": 10,
          "when": [
            {
              "kind": "turn",
              "op": ">=",
              "value": 1
            },
            {
              "kind": "asset",
              "scope": "self",
              "key": "legitimacy",
              "op": ">=",
              "value": 0.3
            }
          ]
        }
      ],
      "initial": true
    },
    "ritual": {
      "label": "Ритуал",
      "x": 300,
      "y": 100,
      "transitions": [
        {
          "to": "public_campaign",
          "event": "публичная кампания",
          "guard": "слово действует",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "legitimacy",
              "op": ">=",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "public_campaign": {
      "label": "Публичная кампания",
      "x": 530,
      "y": 100,
      "transitions": [
        {
          "to": "scandal",
          "event": "скандал",
          "guard": "законность пошатнулась",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "legitimacy",
              "op": "<",
              "value": 0.35
            }
          ]
        }
      ]
    },
    "scandal": {
      "label": "Скандал",
      "x": 760,
      "y": 100,
      "transitions": [
        {
          "to": "restoration",
          "event": "реставрация",
          "guard": "собор вернул доверие",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": ">=",
              "value": 0.45
            }
          ]
        },
        {
          "to": "disbanded",
          "event": "расформирование",
          "guard": "доверие не вернуть",
          "priority": 30,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.15
            }
          ]
        }
      ]
    },
    "restoration": {
      "label": "Реставрация",
      "x": 760,
      "y": 300,
      "transitions": [
        {
          "to": "public_campaign",
          "event": "новая кампания",
          "guard": "законность восстановлена",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "legitimacy",
              "op": ">=",
              "value": 0.5
            }
          ]
        }
      ]
    },
    "disbanded": {
      "label": "Расформирование",
      "x": 300,
      "y": 300,
      "transitions": [],
      "final": true
    }
  },
  "handlers": {},
  "inputs": {
    "clauses": [
      "turn",
      "asset"
    ],
    "authority": "faction assets"
  }
}
