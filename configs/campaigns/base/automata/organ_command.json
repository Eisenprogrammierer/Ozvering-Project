{
  "schema": 2,
  "id": "organ.command",
  "kind": "organ",
  "name": "Командный орган",
  "description": "Штаб: формирование, укомплектование, планирование, перегрузка, реформа.",
  "initial": "forming",
  "states": {
    "forming": {
      "label": "Формирование",
      "x": 80,
      "y": 100,
      "transitions": [
        {
          "to": "staffing",
          "event": "приказ получен",
          "guard": "орган укомплектован",
          "priority": 10,
          "when": [
            {
              "kind": "turn",
              "op": ">=",
              "value": 1
            },
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.2
            }
          ]
        }
      ],
      "initial": true
    },
    "staffing": {
      "label": "Укомплектование",
      "x": 300,
      "y": 100,
      "transitions": [
        {
          "to": "planning",
          "event": "штат собран",
          "guard": "связи и доверие держат",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": ">=",
              "value": 0.35
            }
          ]
        }
      ]
    },
    "planning": {
      "label": "Планирование",
      "x": 530,
      "y": 100,
      "transitions": [
        {
          "to": "overloaded",
          "event": "перегрузка",
          "guard": "снабжение не успевает",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": "<",
              "value": 0.3
            }
          ]
        }
      ]
    },
    "overloaded": {
      "label": "Перегрузка",
      "x": 760,
      "y": 100,
      "transitions": [
        {
          "to": "reformed",
          "event": "реформа штаба",
          "guard": "резервы вернулись",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.45
            }
          ]
        },
        {
          "to": "disbanded",
          "event": "расформирование",
          "guard": "фракция распалась",
          "priority": 30,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.15
            }
          ]
        }
      ]
    },
    "reformed": {
      "label": "Реформа",
      "x": 760,
      "y": 300,
      "transitions": [
        {
          "to": "staffing",
          "event": "возврат к работе",
          "guard": "штат восстановлен",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": ">=",
              "value": 0.4
            }
          ]
        }
      ]
    },
    "disbanded": {
      "label": "Расформирование",
      "x": 530,
      "y": 300,
      "transitions": [],
      "final": true
    }
  },
  "handlers": {},
  "inputs": {
    "clauses": [
      "turn",
      "asset"
    ],
    "authority": "faction assets"
  }
}
