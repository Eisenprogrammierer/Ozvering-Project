{
  "schema": 2,
  "id": "organ.care",
  "kind": "organ",
  "name": "Орган заботы",
  "description": "Медицина/эвакуация: штат, перегрузка, сортировка, восстановление.",
  "initial": "forming",
  "states": {
    "forming": {
      "label": "Формирование",
      "x": 80,
      "y": 100,
      "transitions": [
        {
          "to": "staffed",
          "event": "штат собран",
          "guard": "орган готов принимать",
          "priority": 10,
          "when": [
            {
              "kind": "turn",
              "op": ">=",
              "value": 1
            },
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.2
            }
          ]
        }
      ],
      "initial": true
    },
    "staffed": {
      "label": "Укомплектование",
      "x": 300,
      "y": 100,
      "transitions": [
        {
          "to": "overloaded",
          "event": "перегрузка",
          "guard": "раненых больше нормы",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": "<",
              "value": 0.35
            }
          ]
        }
      ]
    },
    "overloaded": {
      "label": "Перегрузка",
      "x": 530,
      "y": 100,
      "transitions": [
        {
          "to": "triage",
          "event": "сортировка",
          "guard": "единство и ресурс на пределе",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.35
            }
          ]
        },
        {
          "to": "staffed",
          "event": "поток спал",
          "guard": "снабжение вернулось",
          "priority": 20,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.5
            }
          ]
        }
      ]
    },
    "triage": {
      "label": "Сортировка",
      "x": 760,
      "y": 100,
      "transitions": [
        {
          "to": "restored",
          "event": "восстановление",
          "guard": "поставки налажены",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "supply",
              "op": ">=",
              "value": 0.4
            }
          ]
        },
        {
          "to": "disbanded",
          "event": "расформирование",
          "guard": "фракция распалась",
          "priority": 30,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "cohesion",
              "op": "<",
              "value": 0.15
            }
          ]
        }
      ]
    },
    "restored": {
      "label": "Восстановление",
      "x": 760,
      "y": 300,
      "transitions": [
        {
          "to": "staffed",
          "event": "возврат к работе",
          "guard": "энергия восстановлена",
          "priority": 10,
          "when": [
            {
              "kind": "asset",
              "scope": "self",
              "key": "energy",
              "op": ">=",
              "value": 0.3
            }
          ]
        }
      ]
    },
    "disbanded": {
      "label": "Расформирование",
      "x": 300,
      "y": 300,
      "transitions": [],
      "final": true
    }
  },
  "handlers": {},
  "inputs": {
    "clauses": [
      "turn",
      "asset"
    ],
    "authority": "faction assets"
  }
}
