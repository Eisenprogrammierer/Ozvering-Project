      "expect": {
        "mode": "indirect",
        "predicate": "say",
        "body.predicate": "fight"
      }
    },
    {
      "id": "report_direct",
      "text": "Император сказал: «Империя воюет с Республикой».",
      "kind": "report",
      "expect": {
        "mode": "direct",
        "predicate": "say",
        "body.predicate": "fight"
      }
    }
