      "id": "conditional_plain",
      "text": "Если Империя воюет с Республикой, то Республика воюет с Империей.",
      "kind": "conditional",
      "expect": {
        "antecedent.predicate": "fight",
        "consequent.predicate": "fight"
      }
    },
