{
  "schema": 1,
  "description": "Стартовый корпус парафраз D6.2d: ожидаемый вид и ключевые поля разбора.",
  "phrases": [
    {
      "id": "greeting_hello",
      "text": "Привет.",
      "kind": "greeting"
    },
    {
