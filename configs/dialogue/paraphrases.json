      "text": "Что такое Абвер?",
      "kind": "question",
      "expect": {"wh": "what"}
    },
    {
      "id": "wh_where",
      "text": "Где находится Торговая планета?",
      "kind": "question",
      "expect": {"wh": "where", "body.predicate": "locate"}
