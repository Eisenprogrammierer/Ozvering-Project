{
  "schema": 1,
  "enabled": true,
  "hint_priority": 40,
  "hint_min_weight": 0.8,
  "rules": [
    {
      "id": "enemy_hostile",
      "style": "hostile",
      "priority": 100,
      "description": "Стороны в состоянии войны — враждебный регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "at_war_with",
          "args": ["$speaker_faction", "$player_faction"]
        }
      ]
    },
    {
      "id": "enemy_hostile_reverse",
      "style": "hostile",
      "priority": 100,
      "description": "Обратное направление войны — тоже враждебно.",
      "when": [
        {
          "kind": "fact",
          "rel": "at_war_with",
          "args": ["$player_faction", "$speaker_faction"]
        }
      ]
    },
    {
      "id": "superior_report",
      "style": "report",
      "priority": 80,
      "description": "Игрок имеет полномочия над собеседником — доклад.",
      "when": [
        {
          "kind": "fact",
          "rel": "has_authority",
          "args": ["$player_id", "$speaker_id"]
        }
      ]
    },
    {
      "id": "superior_order",
      "style": "order",
      "priority": 90,
      "description": "Собеседник имеет полномочия над игроком — приказ.",
      "when": [
        {
          "kind": "fact",
          "rel": "has_authority",
          "args": ["$speaker_id", "$player_id"]
        }
      ]
    },
    {
      "id": "ally_friendly",
      "style": "friendly",
      "priority": 60,
      "description": "Стороны в союзе — дружеский регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "allied_with",
          "args": ["$speaker_faction", "$player_faction"]
        }
      ]
    },
    {
      "id": "same_faction_friendly",
      "style": "friendly",
      "priority": 55,
      "description": "Одна фракция — дружеский регистр.",
      "when": [
        {
          "kind": "field",
          "field": "player_side",
          "op": "eq",
          "value": "$side"
        }
      ]
    },
    {
      "id": "trusts_mentor",
      "style": "mentor",
      "priority": 50,
      "description": "Доверие без союза — наставительный регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "trusts",
          "args": ["$player_id", "$speaker_id"]
        }
      ]
    },
    {
      "id": "relation_xenophobia",
      "style": "hostile",
      "priority": 88,
      "description": "Расположение к игроку резко отрицательное — враждебный регистр.",
      "when": [
        {
          "kind": "field",
          "field": "relation_affinity",
          "op": "<=",
          "value": -0.45
        }
      ]
    },
    {
      "id": "relation_fear_hostile",
      "style": "hostile",
      "priority": 87,
      "description": "Страх и неприязнь вместе дают враждебный регистр.",
      "when": [
        {
          "kind": "field",
          "field": "relation_fear",
          "op": ">=",
          "value": 0.45
        },
        {
          "kind": "field",
          "field": "relation_affinity",
          "op": "<=",
          "value": -0.1
        }
      ]
    },
    {
      "id": "relation_fear_report",
      "style": "report",
      "priority": 86,
      "description": "Сильный страх перед игроком — подчинённый доклад.",
      "when": [
        {
          "kind": "field",
          "field": "relation_fear",
          "op": ">=",
          "value": 0.55
        },
        {
          "kind": "field",
          "field": "relation_affinity",
          "op": ">=",
          "value": -0.1
        }
      ]
    },
    {
      "id": "belief_threat_hostile",
      "style": "hostile",
      "priority": 92,
      "description": "Собеседник считает фракцию игрока угрозой — враждебный регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "belief",
          "args": [
            "$speaker_id",
            "$speaker_faction",
            "sees_as_threat",
            "$player_faction"
          ]
        }
      ]
    },
    {
      "id": "belief_outlaw_hostile",
      "style": "hostile",
      "priority": 91,
      "description": "Собеседник считает фракцию игрока незаконной — враждебный регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "belief",
          "args": [
            "$speaker_id",
            "$speaker_faction",
            "considers_illegitimate",
            "$player_faction"
          ]
        }
      ]
    },
    {
      "id": "intention_coerce_hostile",
      "style": "hostile",
      "priority": 90,
      "description": "Собеседник намерен принудить фракцию игрока — враждебный регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "intention",
          "args": ["$speaker_id", "$player_faction", "coerce"]
        }
      ]
    },
    {
      "id": "relation_trust_friendly",
      "style": "friendly",
      "priority": 72,
      "description": "Собеседник доверяет игроку — дружеский регистр.",
      "when": [
        {
          "kind": "field",
          "field": "relation_trust",
          "op": ">=",
          "value": 0.35
        }
      ]
    },
    {
      "id": "relation_respect_mentor",
      "style": "mentor",
      "priority": 70,
      "description": "Уважение без близости — наставительный регистр.",
      "when": [
        {
          "kind": "field",
          "field": "relation_respect",
          "op": ">=",
          "value": 0.55
        },
        {
          "kind": "field",
          "field": "relation_affinity",
          "op": ">=",
          "value": 0.0
        }
      ]
    },
    {
      "id": "belief_allied_friendly",
      "style": "friendly",
      "priority": 66,
      "description": "Собеседник считает фракции союзными — дружеский регистр.",
      "when": [
        {
          "kind": "fact",
          "rel": "belief",
          "args": [
            "$speaker_id",
            "$speaker_faction",
            "allied_with",
            "$player_faction"
          ]
        }
      ]
    },
    {
      "id": "default_official",
      "style": "official",
      "priority": 10,
      "description": "Формальный разговор без явных отношений — канцелярит.",
      "when": [
        {
          "kind": "field",
          "field": "player_id",
          "op": "exists",
          "value": null
        }
      ]
    }
  ]
}