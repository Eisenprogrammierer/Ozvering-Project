{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ozvering.local/schemas/subfaction.schema.json",
  "title": "Подфракция",
  "description": "Запись subfactions у фракции. Читается _build_subfactions.",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "share": {
      "type": "number"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "organ_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "organs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "https://ozvering.local/schemas/organ.schema.json"
          }
        ]
      }
    },
    "automaton": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
