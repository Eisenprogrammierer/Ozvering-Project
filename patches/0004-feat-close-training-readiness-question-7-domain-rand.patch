+def test_train_domain_randomize_is_reproducible_and_skips_duel():
+    from agents.train import train
+
+    opts = {
+        "profiles": ("CANON", "ZEALOT"),
+        "health_factors": ("aging",),
+        "sickness_min": 0.0,
+        "sickness_max": 0.5,
+        "health_min": 0.75,
+        "health_max": 1.25,
+        "skill_jitter": 0.0,
+    }
+    results = []
+    for _ in range(2):
+        _policy, stats = train(
+            episodes=3,
+            seed=11,
+            policy_name="bdi",
+            opponent_name="random",
+            max_steps=25,
+            env_name="arena",
+            eval_episodes=0,
+            domain_randomize=True,
+            domain_opts=opts,
+        )
+        results.append(stats)
+    assert results[0]["domain_randomize"] is True
+    assert results[0] == results[1]
+    # duel — легаси-срез без доменов: фича честно не применяется.
+    _policy, duel_stats = train(
+        episodes=2,
+        seed=1,
+        policy_name="bdi",
+        opponent_name="random",
+        max_steps=20,
+        env_name="duel",
+        eval_episodes=0,
+        domain_randomize=True,
+        domain_opts=opts,
+    )
+    assert duel_stats["domain_randomize"] is False
