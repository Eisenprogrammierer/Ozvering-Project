diff --git a/core41/types.py b/core41/types.py
index 8ec450a..8e6c10b 100644
--- a/core41/types.py
+++ b/core41/types.py
@@ -49,3 +49,68 @@ class Transition:
     done: bool
     next_actions: tuple = ()
     info: dict = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class CampaignAction:
+    """Действие кампанейного среза (проблема №6 готовности к обучению).
+
+    Кампания живёт на дневном такте `WorldEngine`, а не на секундном тике
+    арены, поэтому использует отдельный тип действия поверх того же
+    контракта Work/Action/Observation/Transition:
+
+    - ``kind`` — идентификатор действия из конфига мира (``inspect``,
+      ``reform``, …) либо служебный ``END_DAY`` (ход мира и дневной срез);
+    - ``target`` — id узла-цели (пусто для self-действий и ``END_DAY``);
+    - ``form``/``fraction`` — зарезервированы под будущую проекцию
+      кампанейных ресурсов на каналы ядра; в текущем MVP не используются.
+    """
+
+    kind: str = "END_DAY"
+    target: str = ""
+    form: str = ""
+    fraction: float = 0.0
+
+
+@dataclass(frozen=True)
+class CampaignObservation:
+    """Наблюдение игрока-автомата в кампании (плоское, нормированное).
+
+    Все величины приведены к [0, 1] там, где это возможно, чтобы тот же
+    пайплайн признаков, что и на арене, мог работать без правок. Поля
+    соответствуют открытым вопросам §7 (28–31): распад организации и
+    потеря должности наблюдаются через ``power``/``cohesion``/``standing``
+    и флаги ``collapsed``/``dismissed``; финалы бесконечного сценария
+    помечены как ``truncated``-состояния среды, а не объективной победы.
+    """
+
+    day: int = 1
+    total_days: int = 1
+    actions_left: int = 0
+    actions_per_day: int = 1
+    # Состояние персонажа (health/sickness — то же ядро, что и на арене).
+    health: float = 100.0
+    max_health: float = 100.0
+    sickness: float = 0.0
+    alive: bool = True
+    # Ресурсы позиции (легаси-шкалы как проекции ядра: F-канал позиции).
+    influence: float = 0.0
+    favor: float = 0.0
+    evidence: float = 0.0
+    standing: float = 0.0
+    authority: float = 0.0
+    # Статистика собственной организации (узел должности).
+    power: float = 0.0
+    wealth: float = 0.0
+    legitimacy: float = 0.0
+    cohesion: float = 0.0
+    reach: float = 0.0
+    capacity: float = 0.0
+    # Признаки завершения сюжета.
+    attached: bool = False
+    finished: bool = False
+    outcome: str = ""
+    collapsed: bool = False
+    dismissed: bool = False
+    time: float = 0.0
+    extra: dict = field(default_factory=dict)
diff --git a/docs/AGENTS.md b/docs/AGENTS.md
index e36a344..7971231 100644
--- a/docs/AGENTS.md
+++ b/docs/AGENTS.md
@@ -226,6 +226,25 @@ venv/bin/python -m agents.train --episodes 500 --seed 0
 venv/bin/python -m agents.train --episodes 500 --seed 0 --env duel
 ```
 
+Дневной кампанейный срез (проблема готовности №6) выбирается флагом
+`--env campaign`: там один агент без оппонента и без self-play, действие —
+`CampaignAction` (`END_DAY` плюс ordinary/heal-ход `WorldEngine`), награда —
+`campaign_reward()` из дельт положения/организации/здоровья/болезни с
+терминальным бонусом исхода ±1.0; горизонт `max_days` — усечение, а не
+поражение (вопрос №30 открыт):
+
+```bash
+venv/bin/python -m agents.train --episodes 100 --seed 0 --env campaign \
+    --policy bdi
+```
+
+Кампанейные наблюдения проходят через `campaign_features()` (те же 18
+признаков), поэтому `bdi`/`mlp` работают без правок; для таблиц есть
+отдельный вид `qtable-campaign` — его ключ строится из дневных разрядов и
+не смешивается с аренной Q-таблицей. Персистентность среды:
+`CampaignEnv.state_dict()/load_state_dict()` сохраняют снимок мира, сид и
+горизонт.
+
 Обучение по умолчанию идёт в self-play: обе стороны получают собственный
 `Transition` и обновляют свои политики. Отключить обучение противника можно
 флагом `--no-self-play`; тогда он остаётся фиксированным спарринг-партнёром.
